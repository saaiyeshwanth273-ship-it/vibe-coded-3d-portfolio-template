# GEMINI_API_KEY: Optional server-side Gemini API key (never exposed to client bundle)
GEMINI_API_KEY=""

# APP_URL: The public or local URL where this portfolio is hosted
APP_URL="http://localhost:3000"

# Owner Identity & Private CMS Authentication
# Designated owner email allowed to access /admin (replace with your own email)
OWNER_EMAIL="your-email@example.com"
# Optional scrypt salt:hash password override for email/password CMS login
OWNER_PASSWORD_HASH=""
# Cryptographic signing secret for HttpOnly CMS session cookies (auto-generated if omitted)
SESSION_SECRET=""

# PostgreSQL / Cloud SQL Connection Variables
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Outbound Email Delivery for "Send a Direct Message" (optional — configure either SMTP or Resend)
# Option A: SMTP (e.g., Gmail SMTP with a 16-character App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Option B: Resend HTTP API
RESEND_API_KEY=""
RESEND_FROM=""
